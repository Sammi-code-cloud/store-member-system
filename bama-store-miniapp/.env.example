# Copy to .env.local for development, or .env.production.local for release builds.
# Include the deployment prefix (such as /bama), but do not append /api.
# WeChat request-domain settings use only the HTTPS origin, without a path.
VITE_API_BASE_URL=https://example.com/bama

# Required public operator information; configure in ignored .env.local / .env.production.local
VITE_LEGAL_OPERATOR=示例运营主体
VITE_PRIVACY_CONTACT_PHONE=13800000000
VITE_LEGAL_ADDRESS=示例通信地址
